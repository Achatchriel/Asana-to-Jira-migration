# Skopiuj do .env (albo uzupełnij w panelu: zakładka Start / Konfiguracja).
# Wymagane są tylko sekcje Jira, Asana i Google Sheets - reszta ma rozsądne wartości domyślne.

# --- Jira (WYMAGANE) ------------------------------------------------------
# Adres Twojej instancji Jira Cloud, np. https://twojafirma.atlassian.net
JIRA_BASE_URL=https://twojafirma.atlassian.net
# Email konta, na które wygenerowano token API (konto z uprawnieniem administratora Jiry)
JIRA_EMAIL=twoj.email@firma.com
# Wygeneruj na: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# --- Asana (WYMAGANE) -----------------------------------------------------
# Personal Access Token: https://app.asana.com/0/my-apps
ASANA_TOKEN=
# GID workspace'u Asana, z którego mają być pobrane projekty (panel pokaże listę po wpisaniu tokenu)
ASANA_WORKSPACE_GID=

# --- Google Sheets (WYMAGANE) ---------------------------------------------
# Ścieżka do pliku JSON z kluczem konta serwisowego Google
# (Google Cloud Console -> IAM & Admin -> Service Accounts -> Keys). Panel może zapisać
# wklejony klucz do ./service_account.json i pokaże adres, któremu trzeba udostępnić arkusz
# (jak zwykłemu użytkownikowi, z dostępem "Viewer"; "Editor", jeśli skrypty mają wpisywać klucze Jiry).
GOOGLE_APPLICATION_CREDENTIALS=./service_account.json
# ID arkusza - z URL: https://docs.google.com/spreadsheets/d/TU_JEST_ID/edit
GOOGLE_SHEET_ID=
# Zakres komórek do odczytu (zakładka + kolumny). Pierwszy wiersz to nagłówki, m.in.
# project_name, jira_key, asana_project_link, lead_account_id, board_template_id.
GOOGLE_SHEET_RANGE=Arkusz1!A:F

# --- Projekt i tablica wzorcowa (zalecane) --------------------------------
# Klucz ISTNIEJĄCEGO w Jira projektu (company-managed), z którego skopiowany
# zostanie workflow, schemat ekranów (layout), konfiguracja pól, uprawnienia
# i powiadomienia do każdego nowo tworzonego projektu. Z niego panel bierze też
# listę statusów do mapowania sekcji Asany.
# Puste = nie kopiuj konfiguracji, użyj ustawień domyślnych Jira.
# Wymaga uprawnień administratora Jira (Administer Jira global permission).
JIRA_TEMPLATE_PROJECT_KEY=
# ID tablicy wzorcowej (układ kolumn), gdy projekt wzorcowy ma więcej niż jedną tablicę.
# Puste = tablica projektu wzorcowego. Wiersz arkusza może to nadpisać (board_template_id).
JIRA_TEMPLATE_BOARD_ID=

# --- Wartości domyślne tworzonych projektów (opcjonalne) ------------------
# Wszystkie tworzone projekty będą tablicami Kanban, typ: company-managed (klasyczny,
# zarządzany centralnie przez admina Jira).
# Używane, gdy w arkuszu brak kolumny project_type_key / template_key dla wiersza.
DEFAULT_PROJECT_TYPE_KEY=software
DEFAULT_TEMPLATE_KEY=com.pyxis.greenhopper.jira:gh-kanban-template
# Jeśli jednak wolisz Kanban "team-managed" (uproszczony, zarządzany samodzielnie
# przez zespół), zamień powyższą linię na:
# DEFAULT_TEMPLATE_KEY=com.pyxis.greenhopper.jira:gh-simplified-agility-kanban

# Domyślny lead (accountId) dla projektów, w których arkusz nie ma wypełnionej
# kolumny lead_account_id. Jira WYMAGA poprawnego leada przy tworzeniu projektu —
# jeśli to pole zostanie puste i wiersz też nie ma leada, tworzenie się nie powiedzie.
# Swój accountId zobaczysz w panelu (Start → test połączenia z Jirą).
DEFAULT_LEAD_ACCOUNT_ID=

# --- Role w tworzonych projektach (opcjonalne) ----------------------------
# Grupa Jira dodawana do KAŻDEGO nowo tworzonego projektu. Puste = nie dodawaj.
# Uwaga: przypisywać zadania można tylko osobom z roli, która w schemacie uprawnień
# ma "Assignable User" (panel to sprawdza w zakładce Statusy i osoby).
DEVELOPER_GROUP_NAME=
# Konkretni użytkownicy (accountId, po przecinku) dodawani do tej samej roli.
DEVELOPER_ACCOUNT_IDS=
# Nazwa roli projektowej dla grupy/użytkowników powyżej. Sprawdź: python list_project_roles.py
DEVELOPER_ROLE_NAME=Developers
# accountId (jeden lub kilka po przecinku) dodawany jako administrator do KAŻDEGO projektu.
ADMIN_ACCOUNT_ID=
ADMIN_ROLE_NAME=Administrators
# true = lead każdego projektu trafia też do roli administratora tego projektu.
ADD_LEAD_AS_ADMIN=false

# --- Synchronizacja zadań (opcjonalne) ------------------------------------
# Domena adresów e-mail w Jirze, wg wzorca Imię.Nazwisko@domena — dopasowanie awaryjne
# osób przy mapowaniu (gdy e-mail w Asanie różni się od tego w Jirze).
JIRA_EMAIL_DOMAIN=firma.com
# Pole niestandardowe wymagane przy tworzeniu zadania, które ma kilka możliwych wartości
# (nie da się go uzupełnić automatycznie). Puste, jeśli nie macie takiego pola.
# Sprawdź ID i dozwolone wartości: python check_required_fields.py KLUCZPROJEKTU
DEFAULT_TYPE_FIELD_ID=
DEFAULT_TYPE_FIELD_VALUE=
# Zadania przeniesione ręcznie do Jiry, oznaczone w tytule w Asanie (regex, bez wielkości liter).
# Domyślnie: "migriert zu Jira" (także z literówkami). Odkomentuj, żeby zmienić.
# MIGRATED_TO_JIRA_PATTERN=mi[rg]{1,2}r?iert\s+zu\s+jira

# --- Powiadomienia (opcjonalne) -------------------------------------------
# Incoming webhook Slacka - podsumowanie każdego przebiegu pipeline'u.
SLACK_WEBHOOK_URL=

# --- Kopia z innej instancji Jiry (tylko copy_project_cross_instance.py) ---
SOURCE_JIRA_BASE_URL=
SOURCE_JIRA_EMAIL=
SOURCE_JIRA_API_TOKEN=

# --- Zaawansowane (zwykle zostaw puste) -----------------------------------
# Plik z mapowaniem nazwa projektu -> wygenerowany klucz Jira (stabilne klucze między uruchomieniami).
PROJECT_KEY_CACHE_FILE=./project_key_cache.json
# Limit czasu ładowania strony ustawień kolumn (ms) przy kroku 2.
BULK_COLUMNS_TIMEOUT_MS=30000
# Dla copy_project.py, gdy Atlassian zmieni frontend (patrz README 11b).
CLOUD_ID=
GRAPHQL_QUERY_HASH=
GRAPHQL_OPERATION=
# Tylko atlassian_suspend_to_deactivate.py (organizacja Atlassian).
ATLASSIAN_ORG_ID=
ATLASSIAN_API_KEY=
